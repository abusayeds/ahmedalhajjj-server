          }
        },
        {
          "name": "9. Update Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Trader Updated\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/update-profile",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "update-profile"]
            }
          }
        }
      ]
    },
