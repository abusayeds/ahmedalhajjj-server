{
  "info": {
    "_postman_id": "ahmedalhajjj-api-collection-v3",
    "name": "AhmedAlhajji Trading Platform API Collection",
    "description": "Complete Postman Collection with Automated Authentication (firstName, lastName, optional phone & address), Subscription Plan Purchase, Stripe Webhook, Coupons, and Trial Management APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "role",
      "value": "user",
      "type": "string"
    },
    {
      "key": "forgotToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "verifyForgotToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userEmail",
      "value": "user@example.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "description": "Automated Authentication Folder with 9 Required APIs & Automatic Token/Role Management Scripts.",
      "item": [
        {
          "name": "1. Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && (jsonData.data.token || jsonData.data.accessToken)) {",
                  "    const token = jsonData.data.token || jsonData.data.accessToken;",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('AccessToken automatically saved:', token);",
                  "}",
                  "if (jsonData.data && jsonData.data.email) {",
                  "    pm.collectionVariables.set('userEmail', jsonData.data.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Trader\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\",\n  \"confirmPassword\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "register"]
            }
          }
        },
        {
          "name": "2. Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData.data && (jsonData.data.token || jsonData.data.accessToken)) {",
                  "    const token = jsonData.data.token || jsonData.data.accessToken;",
                  "    pm.collectionVariables.set('accessToken', token);",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('AccessToken automatically saved after OTP:', token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/verify-otp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "verify-otp"]
            }
          }
        },
        {
          "name": "3. Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    const token = jsonData.data.token || jsonData.data.accessToken || (jsonData.data.user && jsonData.data.user.token);",
                  "    if (token) {",
                  "        pm.collectionVariables.set('accessToken', token);",
                  "        pm.collectionVariables.set('token', token);",
                  "        console.log('AccessToken automatically saved on Login:', token);",
                  "    }",
                  "    if (jsonData.data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    }",
                  "    const userRole = (jsonData.data.user && jsonData.data.user.role) || jsonData.data.role || 'user';",
                  "    pm.collectionVariables.set('role', userRole);",
                  "    console.log('Role automatically saved on Login:', userRole);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "login"]
            }
          }
        },
        {
          "name": "4. Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/resend-otp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "resend-otp"]
            }
          }
        },
        {
          "name": "5. Forgot Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('forgotToken', jsonData.data.token);",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.token);",
                  "    console.log('Forgot Password Token automatically saved:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/forgot-password",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "forgot-password"]
            }
          }
        },
        {
          "name": "6. Verify Forgot Password OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('verifyForgotToken', jsonData.data.token);",
                  "    pm.collectionVariables.set('accessToken', jsonData.data.token);",
                  "    console.log('Verify Forgot OTP Token automatically saved:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{forgotToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/verify-forgot-otp",
              "protocol": "http",
              "host": ["localhost"],
              "port": "2002",
              "path": ["api", "v1", "user", "verify-forgot-otp"]
            }
          }
        },
        {
          "name": "7. Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"oldPassword\": \"Password123!\",\n  \"newPassword\": \"NewSecurePass123!\"\n}"
            },
            "url": {
              "raw": "http://localhost:2002/api/v1/user/change-password",
