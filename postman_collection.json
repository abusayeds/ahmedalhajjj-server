    {
      "name": "Signals (Core App)",
      "description": "App screens: Signals Home (market hours), All Signals list\n\n**Access rules:**\n- Free users → previous day active signals only\n- Active subscription → today's active signals filtered by plan (VIP/Forex/Crypto)\n\n**List query params:** category, searchTerm, sort, page, limit\n**Category filters:** All | Forex | Crypto | Gold",
      "item": [
        {
          "name": "Get Global Market Hours",
          "description": "Screen: Signals home → Global Market Hours cards\n\nReturns OPEN/CLOSED status, local time, and UTC session ranges for Sydney, Tokyo, London, New York.",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
