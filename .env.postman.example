# Postman auto-sync (one-time setup)
# Get API key: https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=your_postman_api_key_here

# Optional: put collection inside a specific workspace
# POSTMAN_WORKSPACE_ID=your_workspace_id

# Optional: if you already imported manually, paste collection UID here
# Otherwise first `npm run postman:sync` creates it and saves UID to .postman-sync.json
# POSTMAN_COLLECTION_UID=
